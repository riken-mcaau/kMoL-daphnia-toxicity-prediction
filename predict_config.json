{
    "model": {
        "type": "graph_convolutional",
        "in_features": 45,
        "out_features": 1,
        "hidden_features": 200,
        "molecule_features": 17,
        "edge_features": 12,
        "layer_type": "torch_geometric.nn.GCNConv",
        "layers_count": 2,
        "norm_layer": "kmol.model.layers.BatchNorm",
        "dropout": 0.0,
        "is_residual": 1
    },
    "loader": {
        "type": "csv",
        "input_path": "prediction_data_std.csv",
        "input_column_names": ["Smiles"],
        "target_column_names": ["LogM"]
    },
    "splitter": {
        "type": "index",
        "splits": {
            "train": 0.0,
            "test": 1.0
        }
    },
    "featurizers": [
        {
            "type": "graph",
            "inputs": ["Smiles"],
            "outputs": ["graph"],
            "descriptor_calculator": {"type": "rdkit"}
        }
    ],
    "criterion": {"type": "torch.nn.MSELoss"},
    "transformers": [],
    "optimizer": {
        "type": "torch.optim.AdamW",
        "lr": 0.0001,
        "weight_decay": 1e-05
    },
    "scheduler": {
        "type": "torch.optim.lr_scheduler.OneCycleLR",
        "max_lr": 0.0001,
        "epochs": 200,
        "pct_start": 0.3,
        "div_factor": 25,
        "final_div_factor": 1000
    },
    "checkpoint_path": "checkpoint.pt",
    "output_path": "result_predict/",
    "train_split": "train",
    "train_metrics": [],
    "test_split": "test",
    "target_metric": "rmse",
    "test_metrics": [
        "mae",
        "mse",
        "rmse",
        "r2",
        "pearson"
    ],
    "epochs": 200,
    "batch_size": 8,
    "use_cuda": true,
    "enabled_gpus": [0],
    "seed": 42,
    "cache_location": "cache/",
    "clear_cache": false,
    "log_format": "",
    "log_level": "info"
}
